<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Veyqo.Desktop.Views.MainWindow"
        Title="Veyqo - Remote Control"
        Icon="/Assets/logo.ico"
        Width="1080" Height="740"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="350,*">
        <!-- Control Sidebar -->
        <Border Name="SidebarBorder" Grid.Column="0" BorderThickness="0,0,1,0" Padding="18">
            <StackPanel Spacing="14">
                <!-- Top Brand Header and Theme Controls -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="8" ClipToBounds="True" Background="#4f46e5">
                            <Image Source="/Assets/logo.ico" Width="38" Height="38" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Veyqo" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Local Remote Control" FontSize="11" Opacity="0.65"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Theme Toggle Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Name="ThemeModeButton" Content="☀️" Padding="6,4" ToolTip.Tip="Toggle Light / Dark mode"/>
                        <Button Name="ThemeAutoButton" Content="⚙️" Padding="6,4" ToolTip.Tip="Follow System Theme"/>
                    </StackPanel>
                </Grid>

                <!-- Version Banner -->
                <Border Name="VersionBannerBorder" CornerRadius="6" Padding="10,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="#10b981" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Name="VersionText" Text="Veyqo v1.0.0 (Official Build)" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Name="ThemeLabelText" Text="Dark (OS)" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Status Banner -->
                <Border Name="StatusCardBorder" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="5">
                        <TextBlock Text="LOCAL NETWORK STATUS" FontSize="10" FontWeight="SemiBold" Opacity="0.6"/>
                        <TextBlock Name="LocalIpText" Text="Host: Detecting..." FontSize="13" Foreground="#38bdf8"/>
                        <TextBlock Name="StatusText" Text="Status: Standby" FontSize="12" Foreground="#10b981"/>
                    </StackPanel>
                </Border>

                <!-- QR Pairing Section -->
                <Border Name="QrCardBorder" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="Pair Mobile Device" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <Border Background="#ffffff" CornerRadius="6" Padding="8" Width="150" Height="150">
                            <Image Name="QrCodeImage" Width="134" Height="134" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Scan with Veyqo Mobile to connect" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Direct Connect Section -->
                <Border Name="DirectConnectBorder" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Direct Port Connection" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Name="TargetHostBox" Watermark="Mobile IP Address (e.g. 192.168.1.50)"/>
                        <TextBox Name="TargetPortBox" Text="55443" Watermark="Port"/>
                        <Button Name="ConnectButton" Content="Connect to Mobile"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#4f46e5" Foreground="#ffffff" FontWeight="SemiBold"/>
                        <Button Name="DisconnectButton" Content="Disconnect"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#374151" Foreground="#f87171" FontWeight="SemiBold" IsVisible="False"/>
                    </StackPanel>
                </Border>

                <!-- Bottom Links (GitHub & About) -->
                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Name="GithubButton" Margin="0,0,4,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <TextBlock Text="GitHub" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="1" Name="AboutButton" Content="About" Margin="4,0,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Screen Canvas Area -->
        <Border Name="ViewportBackgroundBorder" Grid.Column="1" Padding="20">
            <Grid>
                <!-- Standby Placeholder -->
                <StackPanel Name="StandbyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#1e293b" HorizontalAlignment="Center">
                        <TextBlock Text="📱" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No Device Connected" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Pair using the QR code or enter mobile port directly" FontSize="13" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Remote Device Viewport -->
                <Border Name="ViewportBorder" CornerRadius="12" ClipToBounds="True" IsVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#475569" BorderThickness="1">
                    <Image Name="RemoteScreenImage" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
