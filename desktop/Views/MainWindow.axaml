<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Veyqo.Desktop.Views.MainWindow"
        Title="Veyqo - Remote Control"
        Width="1050" Height="700"
        MinWidth="800" MinHeight="500"
        Background="#0b0f19"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="340,*">
        <!-- Control Sidebar -->
        <Border Grid.Column="0" Background="#111827" BorderBrush="#1f2937" BorderThickness="0,0,1,0" Padding="20">
            <StackPanel Spacing="16">
                <!-- Branding Header -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#4f46e5">
                        <TextBlock Text="V" Foreground="#ffffff" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Veyqo" FontSize="20" FontWeight="Bold" Foreground="#f9fafb"/>
                        <TextBlock Text="Local Remote Control" FontSize="11" Foreground="#9ca3af"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Banner -->
                <Border Background="#1f2937" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="LOCAL NETWORK STATUS" FontSize="10" FontWeight="SemiBold" Foreground="#6b7280"/>
                        <TextBlock Name="LocalIpText" Text="IP: Detecting..." FontSize="13" Foreground="#38bdf8"/>
                        <TextBlock Name="StatusText" Text="Status: Standby" FontSize="12" Foreground="#10b981"/>
                    </StackPanel>
                </Border>

                <!-- QR Pairing Section -->
                <Border Background="#1e293b" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="Pair Mobile Device" FontSize="13" FontWeight="SemiBold" Foreground="#e2e8f0" HorizontalAlignment="Center"/>
                        <Border Background="#ffffff" CornerRadius="6" Padding="8" Width="160" Height="160">
                            <Image Name="QrCodeImage" Width="144" Height="144" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Scan with Veyqo Mobile to connect" FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Direct Connect Section -->
                <Border Background="#1f2937" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Direct Port Connection" FontSize="13" FontWeight="SemiBold" Foreground="#e5e7eb"/>
                        <TextBox Name="TargetHostBox" Watermark="Mobile IP Address (e.g. 192.168.1.50)"/>
                        <TextBox Name="TargetPortBox" Text="55443" Watermark="Port"/>
                        <Button Name="ConnectButton" Content="Connect to Mobile"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#4f46e5" Foreground="#ffffff" FontWeight="SemiBold"/>
                        <Button Name="DisconnectButton" Content="Disconnect"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#374151" Foreground="#f87171" FontWeight="SemiBold" IsVisible="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Screen Canvas Area -->
        <Border Grid.Column="1" Background="#030712" Padding="20">
            <Grid>
                <!-- Standby Placeholder -->
                <StackPanel Name="StandbyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#1e293b" HorizontalAlignment="Center">
                        <TextBlock Text="📱" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No Device Connected" FontSize="18" FontWeight="SemiBold" Foreground="#94a3b8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Pair using the QR code or enter mobile port directly" FontSize="13" Foreground="#64748b" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Remote Device Viewport -->
                <Border Name="ViewportBorder" Background="#000000" CornerRadius="12" ClipToBounds="True" IsVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#374151" BorderThickness="1">
                    <Image Name="RemoteScreenImage" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
